# Copie este arquivo para .env e ajuste os valores (nunca commitar .env).

# URL do webhook do n8n que recebe os envios do formulário.
N8N_WEBHOOK_URL=https://seu-n8n.exemplo.com/webhook/formulario

# Variáveis para o docker-compose.yml (postgres + n8n).

# --- Banco interno do n8n (workflows, credenciais, execuções) ---
POSTGRES_USER=n8n
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_DB=n8n

# Mesmos valores, com os nomes de variável que o n8n espera para se conectar
# ao Postgres (DB_POSTGRESDB_*). Mantidos duplicados de propósito para ficar
# explícito — se mudar usuário/senha/banco acima, replique aqui também.
DB_POSTGRESDB_USER=n8n
DB_POSTGRESDB_PASSWORD=troque-esta-senha
DB_POSTGRESDB_DATABASE=n8n

# --- Configuração geral do n8n ---
# Chave usada para criptografar credenciais salvas no n8n. Gere uma vez e
# nunca troque depois (trocar invalida credenciais já salvas). Ex.: openssl rand -hex 32
N8N_ENCRYPTION_KEY=gere-uma-chave-aleatoria-de-32-bytes

GENERIC_TIMEZONE=America/Sao_Paulo
TZ=America/Sao_Paulo
