meta {
  name: Webhook n8n - Envio valido
  type: http
  seq: 2
}

post {
  url: {{n8nWebhookUrl}}
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "nome": "João Silva",
    "email": "joao2@email.com",
    "telefone": "13999999999",
    "empresa": "Empresa X",
    "interesse": "Desenvolvimento de sistema",
    "orcamento": 15000,
    "mensagem": "Preciso de um sistema para minha empresa"
  }
}

vars:pre-request {
  n8nWebhookUrl: http://localhost:5678/webhook-test/formulario-contato
}

assert {
  res.status: eq 200
}

docs {
  Simula exatamente o payload que a Server Action `submitForm` (src/app/actions.ts) envia
  para o n8n, sem passar pelo Next.js. Útil para testar/depurar o workflow do n8n
  isoladamente (método HTTP, ativação do workflow, formato esperado do body).
}
